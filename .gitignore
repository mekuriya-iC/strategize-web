# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-lock.yaml
# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# VS Code extensions and settings
.vscode/extensions.json
.vscode/settings.json
.vscode/launch.json

# Generated GraphQL files (regenerated by pnpm run schema:fetch)
src/gql/
src/graphql/queries/
src/graphql/mutations/
src/graphql/fragments/

# Generated schema files (regenerated by pnpm run schema:fetch)
schema.graphql
graphql.schema.json


# Root level documentation (moved to docs/)
SCHEMA_GENERATION_*.md
CLEANUP_UTILITY_GUIDE.md
CASCADING_TEST_PLAN.md
DOCUMENTATION_ORGANIZATION_SUMMARY.md
DOCS_ORGANIZATION_COMPLETE.md
START_HERE.md
DOCUMENTATION.md

# Docs folder - ignore old/duplicate files, keep only essential ones
docs/**/*.md
!docs/INDEX.md
!docs/README.md
!docs/ORGANIZATION_GUIDE.md
!docs/getting-started/README.md
!docs/getting-started/START_HERE.md
!docs/getting-started/DOCUMENTATION.md
!docs/schema-generation/README.md
!docs/schema-generation/QUICK_START.md
!docs/schema-generation/COMPLETE_SYSTEM.md
!docs/schema-generation/DETAILED_GUIDE.md
!docs/schema-generation/WORKFLOW.md
!docs/schema-generation/RULES.md
!docs/schema-generation/VISUAL_GUIDE.md
!docs/schema-generation/CHECKLIST.md
!docs/schema-generation/CLEANUP_GUIDE.md
!docs/utilities/README.md
!docs/utilities/CLEANUP_DATA.md
!docs/utilities/CASCADING_TEST_PLAN.md
!docs/data-validation/README.md
!docs/data-validation/TARGET_VALIDATION_SYSTEM.md
!docs/data-validation/TIMELINE_AND_TARGET_FIXES.md
!docs/data-validation/STRATEGIC_OBJECTIVES_DICTIONARY.md
pnpm-lock.yaml
